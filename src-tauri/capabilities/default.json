{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the main desktop mascot window",
  "windows": ["mascot", "panel", "mascot-menu", "mascot-notification"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "deep-link:default",
    "deep-link:allow-register",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://hlai.hlmc.cn:5900/**" },
        { "url": "http://192.168.0.210:8066/**" },
        { "url": "http://192.168.0.211:8066/**" }
      ]
    },
    "opener:default"
  ]
}
